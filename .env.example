# CareCanvas Environment Variables — SAFE TEMPLATE
# Copy to .env.local for local dev: `cp .env.example .env.local` then fill secrets
# NEVER commit .env.local, .env, or any file with real secrets. They are gitignored.
# VITE_ prefix = EXPOSED TO BROWSER (public). Only put non-sensitive values there.
# Without VITE_ = SERVER-ONLY (private). Use for secrets.

# ─────────────────────────────────────────────────────────────────
# Supabase — Browser (public) — anon key is public by design, but RLS MUST be enabled
# ─────────────────────────────────────────────────────────────────
# Public URL — safe to expose (same for all envs)
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Alternative public URL — same value, kept for backward compat with client.ts priority chain
VITE_SUPABASE_DB_URL="https://YOUR_PROJECT_REF.supabase.co"
# Public anon/publishable key — safe to expose ONLY if RLS is enabled (see src/core/supabase/schema.sql)
# Prefer publishable key (sb_publishable_...) over legacy anon JWT for new projects
# Get from Supabase Dashboard > Project Settings > API Keys or via `supabase_get_publishable_keys` MCP
VITE_SUPABASE_ANON_KEY="sb_publishable_... or eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Optional: also set via server env for Node/test harnesses
# SUPABASE_URL / VITE_SUPABASE_URL fallback is handled in src/core/supabase/client.ts

# ─────────────────────────────────────────────────────────────────
# Supabase — Server-only (private) — NEVER use VITE_ prefix
# ─────────────────────────────────────────────────────────────────
# Postgres direct connection — contains password, server-only
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
SUPABASE_DB_URL="postgresql://postgres:[YOUR-PASSWORD]@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# Optional service role (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY="..."

# ─────────────────────────────────────────────────────────────────
# AI — Browser (public) — non-sensitive config only
# ─────────────────────────────────────────────────────────────────
# Set to /api/ai to proxy through Vercel serverless (api/ai/chat/completions.ts) so the real key stays server-only
VITE_AI_BASE_URL="/api/ai"
VITE_AI_ENABLED="true"
VITE_AI_PROVIDER="chat"
# Any model string — generic, not hardcoded in code
VITE_AI_MODEL="deepseek-v4-flash-vision-exp"
VITE_AI_VISION_MODEL=""
VITE_AI_STRUCTURED_OUTPUTS="true"
VITE_AI_TEMPERATURE="0.1"
VITE_AI_MAX_TOKENS="4096"
VITE_AI_TIMEOUT_MS="30000"

# ─────────────────────────────────────────────────────────────────
# AI — Server-only (private) — NEVER use VITE_ prefix
# ─────────────────────────────────────────────────────────────────
# The real API key for opencode.ai / OpenAI compatible provider — injected by api/ai/* proxy from process.env.AI_API_KEY
# Set in Vercel Dashboard > Project Settings > Environment Variables as Secret (type: secret, no VITE_)
# For local `vite` dev, you may also set VITE_AI_API_KEY in .env.local for convenience, but it WILL be exposed in dev bundle
# For production, ensure VITE_AI_API_KEY is NOT set in Vercel — only AI_API_KEY should exist
AI_API_KEY="sk-..."

# ─────────────────────────────────────────────────────────────────
# Security Notes
# ─────────────────────────────────────────────────────────────────
# 1. All VITE_ vars are embedded in the browser bundle at build time — visible to anyone via View Source or Network tab.
#    Never put postgres passwords, service_role keys, or AI secrets in VITE_ vars for production.
# 2. Supabase anon/publishable key is intentionally public, but you MUST enable Row Level Security (RLS) on all public tables
#    and add policies. This project enables RLS with permissive `FOR ALL TO anon, authenticated USING (true)` as baseline
#    — replace with auth.uid() policies when Supabase Auth is added. See src/core/supabase/schema.sql and migration enable_rls...
# 3. AI calls should go via /api/ai proxy so the server can inject AI_API_KEY. Direct calls to https://opencode.ai with client key expose the key.
# 4. Vercel will block `VITE_` + `Secret` type — use Config for VITE_ (public) and Secret for server-only.
