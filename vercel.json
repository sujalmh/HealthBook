{
  "functions": {
    "api/ai-proxy.ts": {
      "maxDuration": 120
    },
    "api/ocr-proxy.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/api/ai-proxy/(.*)",
      "destination": "/api/ai-proxy"
    },
    {
      "source": "/api/ai-proxy",
      "destination": "/api/ai-proxy"
    },
    {
      "source": "/api/ocr-proxy/(.*)",
      "destination": "/api/ocr-proxy"
    },
    {
      "source": "/api/ocr-proxy",
      "destination": "/api/ocr-proxy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
