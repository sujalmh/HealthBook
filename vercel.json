{
  "functions": {
    "api/ai-proxy.ts": {
      "maxDuration": 120
    },
    "api/ocr-proxy.ts": {
      "maxDuration": 120
    },
    "api/supabase.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/ai-proxy/:match*",
      "destination": "/api/ai-proxy"
    },
    {
      "source": "/api/ai-proxy",
      "destination": "/api/ai-proxy"
    },
    {
      "source": "/api/ocr-proxy/:match*",
      "destination": "/api/ocr-proxy"
    },
    {
      "source": "/api/ocr-proxy",
      "destination": "/api/ocr-proxy"
    },
    {
      "source": "/api/supabase/:match*",
      "destination": "/api/supabase"
    },
    {
      "source": "/api/supabase",
      "destination": "/api/supabase"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
