{
  "name": "carecanvas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_NO_WARNINGS=1 tsc && NODE_NO_WARNINGS=1 vite build",
    "test": "vitest run",
    "test:all": "tsx test/test-runner.ts",
    "test:tools": "tsx test/test-runner.ts --tier1",
    "test:tier2": "tsx test/test-runner.ts --tier2",
    "test:tier3": "tsx test/test-runner.ts --tier3",
    "test:workloads": "tsx test/test-runner.ts --tier4",
    "test:e2e:flows": "tsx test/test-runner.ts --e2e",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
